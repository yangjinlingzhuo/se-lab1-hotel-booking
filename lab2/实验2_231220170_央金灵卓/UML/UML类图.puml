@startuml UML类图
title Hotel Booking System - Domain Class Diagram

skinparam dpi 150
skinparam defaultFontName "Helvetica Neue"
skinparam classAttributeIconSize 3

class User {
  -userId: string
  -name: string
  -phone: string
  -passwordHash: string
  +verifyLogin(pwd: string): bool
}

class Customer
class HotelStaff {
  -hotelId: string
}
class PlatformAdmin

class Hotel {
  -hotelId: string
  -name: string
  -city: string
  -address: string
  -phone: string
  -status: HotelStatus
  -checkInOutRules: string
  +suspend(period: string, reason: string): void
  +reopen(): void
}

class RoomType {
  -roomTypeId: string
  -name: string
  -bedType: string
  -capacity: int
  -facilities: list<string>
  -images: list<string>
  -status: string
}

class DailyInventory {
  -date: date
  -capacity: int
  -blocked: int
  -occupied: int
  +available(): int
  +occupy(n: int): bool
  +release(n: int): void
}

class DailyPrice {
  -date: date
  -price: money
}

class Order {
  -orderNo: string
  -roomCount: int
  -checkIn: date
  -checkOut: date
  -status: OrderStatus
  -contactName: string
  -contactPhone: string
  -totalPrice: money
  -createdAt: datetime
  +confirm(): void
  +reject(reason: string): void
  +cancel(): void
  +checkIn(): void
  +checkOut(): void
  +expire(): void
}

class OrderNight {
  -date: date
  -nightPrice: money
}

class ChangeRequest {
  -newRoomTypeId: string
  -newCheckIn: date
  -newCheckOut: date
  -newRoomCount: int
  -quotedPrice: money
  -expireAt: datetime
  -status: ChangeStatus
  +approve(): bool
  +reject(reason: string): void
}

class OperationLog {
  -operatorId: string
  -action: string
  -beforeStatus: string
  -afterStatus: string
  -reason: string
  -requestId: string
  -time: datetime
}

' 布局辅助
Order -[hidden]r- Hotel
Hotel -[hidden]d- RoomType
RoomType -[hidden]d- DailyInventory
DailyInventory -[hidden]r- DailyPrice
Order -[hidden]d- ChangeRequest
Order -[hidden]r- OrderNight

User <|-- Customer
User <|-- HotelStaff
User <|-- PlatformAdmin

HotelStaff "n" --> "1" Hotel : belongs to
Hotel "1" *-- "n" RoomType
RoomType "1" *-- "n" DailyInventory
RoomType "1" *-- "n" DailyPrice
Customer "1" *-- "n" Order : places
Order "n" --> "1" Hotel
Order "n" --> "1" RoomType
Order "1" *-- "n" OrderNight : occupies
Order "1" *-- "0..1" ChangeRequest : pending
OperationLog "n" --> "1" User : operated by

note right of DailyInventory
  unique (roomType, date)
  available = capacity - blocked - occupied >= 0
end note

note left of Order
  totalPrice and OrderNight prices are
  frozen snapshots at booking time (REQ-005)
end note

@enduml
