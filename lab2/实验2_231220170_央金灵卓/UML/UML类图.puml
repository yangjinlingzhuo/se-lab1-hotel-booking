@startuml UML类图
title Hotel Booking System - Domain Class Diagram

skinparam dpi 150
skinparam defaultFontName "Helvetica Neue"
skinparam classAttributeIconSize 3
skinparam linetype polyline

class User {
  -userId: UUID
  -name: string
  -phone: string
  -passwordHash: string
}

class Customer
class HotelStaff
class PlatformAdmin

class Hotel {
  -hotelId: UUID
  -name: string
  -city: string
  -address: string
  -phone: string
  -status: HotelStatus
  -checkInOutRules: string
  +suspend(period: string, reason: string): void
  +reopen(): void
}

class RoomType {
  -roomTypeId: UUID
  -name: string
  -bedType: string
  -capacity: int
  -facilities: list<string>
  -images: list<string>
  -status: string
}

class DailyInventory {
  -date: date
  -capacity: int
  -blocked: int
  -reserved: int
  -occupied: int
  /available: int
  +occupy(n: int): bool
  +release(n: int): void
}

class DailyPrice {
  -date: date
  -price: money
  -currency: string
}

class Order {
  -orderNo: string
  -roomCount: int
  -checkIn: date
  -checkOut: date
  -status: OrderStatus
  -contactName: string
  -contactPhone: string
  -totalPrice: money
  -createdAt: datetime
  -actualCheckInAt: datetime
  -actualCheckOutAt: datetime
  +confirm(): void
  +reject(reason: string): void
  +cancel(): void
  +checkIn(): void
  +checkOut(): void
  +expire(): void
}

class OrderNight {
  -date: date
  -nightPrice: money
}

class ChangeRequest {
  -newRoomTypeId: UUID
  -newCheckIn: date
  -newCheckOut: date
  -newRoomCount: int
  -quotedPrice: money
  -status: ChangeStatus
  -createdAt: datetime
  -processedAt: datetime
  -processedBy: UUID
  -expireAt: datetime
  +approve(): bool
  +reject(reason: string): void
}

class OperationLog {
  -operationId: UUID
  -action: OperationType
  -targetType: TargetType
  -targetId: UUID
  -beforeStatus: Status
  -afterStatus: Status
  -reason: string
  -createdAt: datetime
}

' 布局辅助（四分区：用户权限 / 预订 / 酒店 / 库存价格）
OperationLog -[hidden]r- User
User -[hidden]d- Customer
Customer -[hidden]r- HotelStaff
HotelStaff -[hidden]r- PlatformAdmin
HotelStaff -[hidden]d- Hotel
Customer -[hidden]d- Order
OrderNight -[hidden]r- Order
Order -[hidden]r- Hotel
Order -[hidden]d- ChangeRequest
Hotel -[hidden]d- RoomType
RoomType -[hidden]d- DailyInventory
DailyInventory -[hidden]r- DailyPrice

' 继承
User <|-- Customer
User <|-- HotelStaff
User <|-- PlatformAdmin

' 关联与组合
Hotel "1" -- "0..*" HotelStaff : employs
Hotel "1" *-- "n" RoomType
RoomType "1" *-- "n" DailyInventory
RoomType "1" *-- "n" DailyPrice
Customer "1" -- "0..*" Order : places
Order "n" --> "1" Hotel
Order "n" --> "1" RoomType
Order "1" *-- "n" OrderNight : occupies
Order "1" *-- "0..*" ChangeRequest : changeRequests
OperationLog "0..*" -- "1" User : performed by

note left of DailyInventory
  unique (roomType, date)
  /available = capacity - blocked
    - reserved - occupied >= 0
  reserved: booked not yet checked in
  occupied: actually checked in
end note

note left of Order
  totalPrice and OrderNight prices are
  frozen snapshots at booking time (REQ-005)
end note

note bottom of ChangeRequest
  at most one PENDING ChangeRequest
  per Order at any time (REQ-012)
end note

note right of User
  roles are mutually exclusive per account;
  authentication is handled by
  AuthenticationService, not User
end note

@enduml
